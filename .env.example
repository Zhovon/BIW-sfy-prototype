# --- Admin area (/admin) ---
# Single shared password gate for the admin dashboard. If unset, /admin is
# effectively locked (login always fails). Set a strong value in production.
ADMIN_PASSWORD=change-me

# --- SSLCommerz payment gateway ---
# Defaults (unset) use the public SANDBOX test store (testbox / qwerty).
# To go LIVE, set all three and provide real merchant credentials:
# SSLC_STORE_ID=your_live_store_id
# SSLC_STORE_PASSWD=your_live_store_passwd
# SSLC_IS_LIVE=true

# Public base URL the gateway redirects back to (success/fail/cancel/ipn).
# MUST be publicly reachable for callbacks to work — use an ngrok/tunnel URL
# in dev, or the deployed domain in production. Localhost callbacks will NOT
# be reachable by SSLCommerz servers.
APP_URL=http://localhost:3002

# --- SEO ---
# Canonical public origin used for sitemap.xml, robots.txt, canonical links and
# OpenGraph URLs. Defaults to https://biw.beauty; override on previews/tunnels.
NEXT_PUBLIC_SITE_URL=https://biw.beauty

# --- Contact form (Resend) ---
# The contact form (/pages/contact) emails submissions via Resend. Without these
# set, the form returns a clear "not configured" message instead of silently
# dropping the message. Get a key at https://resend.com.
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=hello@biw.beauty                # where messages are delivered
# CONTACT_FROM=BIW Website <noreply@biw.beauty>    # must be a Resend-verified sender

# --- Bookings (CRM) ---
# Origin of the CRM app that hosts the /book appointment widget (availability +
# booking). The storefront embeds it in an iframe for service items. Defaults to
# the production CRM; override to a preview/staging CRM when testing.
NEXT_PUBLIC_CRM_URL=https://crm.biw.salon
